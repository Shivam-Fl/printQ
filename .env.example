# ============================================================
# PrintQ environment — copy to .env and fill in real values.
# NEVER commit .env. Every secret here must come from env vars.
# ============================================================

# --- Core ---
NODE_ENV=development
PRINTQ_ENVIRONMENT=development
PORT=4000
# Comma-separated allowlist. No wildcards in production.
CORS_ORIGINS=http://localhost:5173
# Public URL of the student/dashboard web app (used in notification links)
PUBLIC_WEB_URL=http://localhost:5173
# Backend proxy for one-time shop address lookup. The default public endpoint
# is suitable only for low-volume pilot use and is throttled/cached by PrintQs.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# --- Database (docker-compose maps host 15432 → container 5432) ---
# The database name must contain DATABASE_NAMESPACE. Never point this at a
# production database; config validation rejects a namespace mismatch.
DATABASE_NAMESPACE=development
DATABASE_URL=postgresql://printq:printq_dev_only@localhost:15432/printq_development

# --- Redis (docker-compose maps host 6380 → container 6379) ---
REDIS_URL=redis://localhost:6380
# Namespaces queues even when a managed Redis server is reused for development.
QUEUE_NAMESPACE=printq-development
# `all` keeps local development combined. Cloud Run uses `conversion` and
# `maintenance` in separate worker pools.
WORKER_ROLE=all

# --- Auth secrets (generate: openssl rand -hex 32) ---
JWT_SECRET=change_me_64_hex_chars
# Extra server-side pepper mixed into hashed OTPs
OTP_PEPPER=change_me_32_hex_chars

# --- Student phone auth: local | firebase ---
# local keeps the hashed server OTP flow for development. firebase uses
# Firebase Phone Auth in the browser, then exchanges the verified ID token for
# a PrintQ JWT. The API key is public configuration, not a service-account key.
STUDENT_AUTH_PROVIDER=local
FIREBASE_AUTH_API_KEY=
FIREBASE_PROJECT_ID=
# disabled | monitor | enforce. Start monitor only after a Firebase App Check
# provider is configured for this environment; the API uses Cloud Run ADC.
FIREBASE_APP_CHECK_MODE=disabled
FIREBASE_PROJECTIONS_ENABLED=false
# Enables Firebase Cloud Messaging only after the matching Firebase web app
# has a Web Push certificate and isolated-development delivery QA has passed.
FIREBASE_FCM_ENABLED=false
# Web-only public reCAPTCHA v3 site key for the matching Firebase project.
# This is a public identifier, not a server secret.
VITE_FIREBASE_APP_CHECK_MODE=disabled
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# --- Storage: local | s3 | gcs ---
STORAGE_DRIVER=local
# local driver root (dev only)
STORAGE_LOCAL_DIR=./storage
# gcs driver: private bucket accessed through Cloud Run's service identity;
# no service-account JSON or HMAC credential belongs in this file.
GCS_BUCKET=printqs-development-private
# s3 driver (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=printq-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# force path style for MinIO/R2 compat
S3_FORCE_PATH_STYLE=true
# Logical object keys are namespaced before reaching the bucket. Use distinct
# buckets and credentials as well; this is a second isolation boundary.
STORAGE_NAMESPACE=printq-development

# --- Payments: mock | razorpay ---
PAYMENT_PROVIDER=mock
# 2500 basis points = 25% added to the shop's private base prices.
PLATFORM_MARKUP_BPS=2500
# mock exercises the private earnings ledger without moving money.
# razorpay_route aggregates earnings into Direct Transfers to Linked Accounts.
SHOP_PAYOUT_PROVIDER=mock
MIN_SHOP_PAYOUT_PAISE=50000
MAX_SHOP_CASH_DEBT_PAISE=50000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications ---
# In-app (socket) always on. Web Push for the installed PWA needs VAPID keys:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Student login SMS: console | msg91 ---
# Login OTPs happen before any session exists (can't be in-app). console just
# logs to the API — required for a real launch. MSG91 is a plain REST call.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Shop-owner forgot-password email: console | resend ---
# Production requires resend and a verified PrintQs sender domain. Console is
# for isolated local tests only and never exposes a reset code in logs.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# --- Platform administrator bootstrap ---
# Production requires both values. Generate the password hash offline with
# argon2id; never place a plaintext password in an environment variable or Git.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# --- Queue behaviour ---
# Minutes a student has to give the release OTP after being notified
OTP_WINDOW_MINUTES=10
# Minutes after a no-show during which one free requeue is allowed
NO_SHOW_GRACE_MINUTES=30
# Unprinted uploads expire after this hard maximum (24 hours). Successful
# prints and cancelled/expired jobs always delete exactly ten minutes after
# the verified print/terminal event; they do not use this setting.
FILE_UNPRINTED_RETENTION_MINUTES=1440
# Only tests and the explicit desktop simulator may auto-confirm a print.
# Real printer spool acceptance requires authenticated staff confirmation.
ALLOW_SIMULATED_PRINT_COMPLETION=false
# Auto-cancel/refund paid orders that never check in (7 days by default)
PREPARED_ORDER_TTL_HOURS=168
# "Almost your turn" alert when this many people (or fewer) are ahead
NEAR_FRONT_THRESHOLD=5
# Scheduled jobs become eligible this many minutes before their slot
SCHEDULE_LEAD_MINUTES=10

# --- File conversion ---
# Absolute path to LibreOffice soffice binary (needed for DOCX). Leave blank to
# disable DOCX conversion (PDF/images still work).
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Web app build-time vars (apps/web/.env) ---
# VITE_API_URL=http://localhost:4000
# VITE_STUDENT_AUTH_PROVIDER=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_FCM_VAPID_KEY=
