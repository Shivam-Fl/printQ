# ============================================================
# PrintQ environment — copy to .env and fill in real values.
# NEVER commit .env. Every secret here must come from env vars.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Comma-separated allowlist. No wildcards in production.
CORS_ORIGINS=http://localhost:5173
# Public URL of the student/dashboard web app (used in notification links)
PUBLIC_WEB_URL=http://localhost:5173

# --- Database (docker-compose maps host 15432 → container 5432) ---
DATABASE_URL=postgresql://printq:printq_dev_only@localhost:15432/printq

# --- Redis (docker-compose maps host 6380 → container 6379) ---
REDIS_URL=redis://localhost:6380

# --- Auth secrets (generate: openssl rand -hex 32) ---
JWT_SECRET=change_me_64_hex_chars
# Extra server-side pepper mixed into hashed OTPs
OTP_PEPPER=change_me_32_hex_chars

# --- Storage: local | s3 ---
STORAGE_DRIVER=local
# local driver root (dev only)
STORAGE_LOCAL_DIR=./storage
# s3 driver (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=printq-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# force path style for MinIO/R2 compat
S3_FORCE_PATH_STYLE=true

# --- Payments: mock | razorpay ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications: console | whatsapp ---
NOTIFICATION_PROVIDER=console
# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Queue behaviour ---
# Minutes a student has to give the release OTP after being notified
OTP_WINDOW_MINUTES=10
# Minutes after a no-show during which one free requeue is allowed
NO_SHOW_GRACE_MINUTES=30
# Hours after job completion when stored files are deleted
FILE_RETENTION_HOURS=24

# --- File conversion ---
# Absolute path to LibreOffice soffice binary (needed for DOCX). Leave blank to
# disable DOCX conversion (PDF/images still work).
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Web app build-time vars (apps/web/.env) ---
# VITE_API_URL=http://localhost:4000
