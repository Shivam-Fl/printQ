apiVersion: run.googleapis.com/v1
kind: WorkerPool
metadata:
  name: printqs-development-maintenance
  namespace: ${PRINTQ_PROJECT_ID}
  labels:
    cloud.googleapis.com/location: ${PRINTQ_REGION}
    printqs.io/environment: development
  annotations:
    run.googleapis.com/description: PrintQs development timers retention and reconciliation worker
    run.googleapis.com/manualInstanceCount: "1"
spec:
  template:
    metadata:
      labels:
        printqs.io/environment: development
    spec:
      serviceAccountName: printqs-development-runtime@${PRINTQ_PROJECT_ID}.iam.gserviceaccount.com
      containers:
        - name: maintenance
          image: ${PRINTQ_IMAGE_URI}
          command: [node]
          args: [apps/api/dist/worker.js]
          resources:
            limits:
              cpu: "1"
              memory: 1Gi
          env:
            - name: NODE_ENV
              value: development
            - name: PRINTQ_ENVIRONMENT
              value: development
            - name: WORKER_ROLE
              value: maintenance
            - name: DATABASE_NAMESPACE
              value: development
            - name: QUEUE_NAMESPACE
              value: printq-development
            - name: STORAGE_NAMESPACE
              value: printq-development
            - name: STORAGE_DRIVER
              value: gcs
            - name: GCS_BUCKET
              value: ${PRINTQ_GCS_BUCKET}
            - name: STUDENT_AUTH_PROVIDER
              value: firebase
            - name: FIREBASE_PROJECT_ID
              value: ${PRINTQ_FIREBASE_PROJECT_ID}
            - name: PAYMENT_PROVIDER
              value: mock
            - name: SHOP_PAYOUT_PROVIDER
              value: mock
            - name: EMAIL_PROVIDER
              value: console
            - name: SMS_PROVIDER
              value: console
            - name: PUBLIC_WEB_URL
              value: ${PRINTQ_PUBLIC_WEB_URL}
            - name: CORS_ORIGINS
              value: ${PRINTQ_PUBLIC_WEB_URL}
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: printqs-development-database-url
                  key: latest
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: printqs-development-redis-url
                  key: latest
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: printqs-development-jwt-secret
                  key: latest
            - name: OTP_PEPPER
              valueFrom:
                secretKeyRef:
                  name: printqs-development-otp-pepper
                  key: latest
            - name: FIREBASE_AUTH_API_KEY
              valueFrom:
                secretKeyRef:
                  name: printqs-development-firebase-api-key
                  key: latest
