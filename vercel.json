{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w packages/shared && npm run build -w apps/agent && npm run package:agent && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/((?!assets/|icons/|downloads/|sw.js|manifest.webmanifest|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/downloads/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
